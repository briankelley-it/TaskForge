# Copy this file to .env and adjust. Never commit .env.

# manage.py uses config.settings.dev and wsgi.py uses config.settings.prod by default.
# Override with DJANGO_SETTINGS_MODULE if you need to.

DEBUG=True
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Used by the Postgres container on first start
POSTGRES_DB=taskforge
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=taskforge

# Inside Docker Compose the database host is the "db" service.
# Running Django on your machine instead? Use localhost:5433 (see DB_HOST_PORT).
DATABASE_URL=postgres://taskforge:taskforge@db:5432/taskforge

# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres.
DB_HOST_PORT=5433
